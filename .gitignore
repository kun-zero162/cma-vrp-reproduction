# ============================================================
# CMA-VRP reproduction -- .gitignore
# Repo root == the CMAVRP/ folder (standalone reproduction repo)
# ============================================================

# ---- Python bytecode / packaging ----
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/

# ---- Virtual environments ----
.venv/
.venv*/
env/
venv/
virtualenv/

# ---- Model weights (downloaded, re-obtainable; files >100 MB are rejected by GitHub) ----
bert/
ckpt/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.mlpackage/

# ---- Generated data, feature caches and run outputs ----
cache/
logs/
results/
temp/
*.log

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: the small synthetic demo dataset under data/ is intentionally KEPT so the
# pipeline can be run end-to-end after a fresh clone. To exclude it, uncomment:
# data/
